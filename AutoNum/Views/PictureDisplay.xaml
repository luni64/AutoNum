<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:view="clr-namespace:AutoNumber.Views" 
    xmlns:vm="clr-namespace:AutoNumber.ViewModels" 
    xmlns:is="clr-namespace:AutoNumber.Infrastructure" 
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    x:Class="AutoNumber.Views.PictureDisplay" 
    x:Name="PD" 
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance Type={x:Type vm:MainVM}}"   
    >


    <UserControl.Resources>
        <mah:MathMultiplyConverter x:Key="MathMultiplyConverter"/>
        <is:BitmapToBitmapSource x:Key="Bitmap2BitmapSource"/>
        <is:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <is:DrawingColToMediaBrush  x:Key="Col2Brush"/>
        <is:DrawingFontFamilyToMediaFontFamily x:Key="DrawingFontFamilyToMediaFontFamily"/>

        <Style x:Key="RowBoundaryThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Rectangle Fill="{TemplateBinding Background}"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBoundaryLineThumbStyle" TargetType="primitives:Thumb">
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <view:ZoomBorder                    
        x:Name="border"                  
        ClipToBounds="True"        
        PanX="{Binding Page.PanX, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}"
        PanY="{Binding Page.PanY, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}"
        Zoom="{Binding Page.Zoom, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}"                  
        >
        <Canvas x:Name="PageCanvas">
            <StackPanel x:Name="topTextPanel"
                Canvas.Left="0"
                Canvas.Top="{Binding ActualHeight, ElementName=topTextPanel, Mode=OneWay, ConverterParameter=-1, Converter={StaticResource MathMultiplyConverter}}"
                Width="{Binding ActualWidth, ElementName=pageimg, Mode=OneWay}"
                SizeChanged="TopTextPanel_SizeChanged">
                <Border DataContext="{Binding TitleManager}"
                    Visibility="{Binding IsEnabled, Mode=OneWay ,Converter={StaticResource Bool2Vis}}"
                    BorderThickness="1,1,1,0"
                    BorderBrush="DarkGray"
                    Background="{Binding BackgroundColor, Converter={StaticResource Col2Brush}}">
                    <TextBlock
                        Text="{Binding Title}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontFamily="{Binding TitleFontFamily, Converter={StaticResource DrawingFontFamilyToMediaFontFamily}, Mode=OneWay}"
                        FontSize="{Binding TitleFontSize}"
                        Foreground="{Binding TitleFontColor, Converter={StaticResource Col2Brush}}"
                        Padding="0,4"/>
                </Border>
                <Border DataContext="{Binding ImageInfoManager}"
                    Visibility="{Binding IsEnabled, Mode=OneWay ,Converter={StaticResource Bool2Vis}}"
                    BorderThickness="1,1,1,0"
                    BorderBrush="DarkGray"
                    Background="{Binding BackgroundColor, Converter={StaticResource Col2Brush}}">
                    <TextBlock
                        Text="{Binding ImageInfo}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        TextAlignment="Left"
                        TextWrapping="Wrap"
                        FontFamily="{Binding ImageInfoFontFamily, Converter={StaticResource DrawingFontFamilyToMediaFontFamily}, Mode=OneWay}"
                        FontSize="{Binding ImageInfoFontSize}"
                        Foreground="{Binding ImageInfoFontColor, Converter={StaticResource Col2Brush}}"
                        Padding="8,4,8,4"/>
                </Border>
            </StackPanel>
            <Image                         
                x:Name="pageimg"                       
                HorizontalAlignment="Left" VerticalAlignment="Top"      
                ClipToBounds="true"                   
                Width="{Binding Page.ImageWidth, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}" 
                Source="{Binding Page.Bitmap, Converter={StaticResource Bitmap2BitmapSource}, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}" 
                />
            <Border x:Name="imageIdBorder"
                DataContext="{Binding ImageIdManager}"
                Visibility="{Binding ShowImageIdLine, Converter={StaticResource Bool2Vis}}"
                Canvas.Left="0"
                Canvas.Top="{Binding ActualHeight, ElementName=pageimg, Mode=OneWay}"
                Width="{Binding ActualWidth, ElementName=pageimg, Mode=OneWay}"
                Height="{Binding LineHeight}"
                BorderThickness="0"
                Background="{Binding BackgroundColor, Converter={StaticResource Col2Brush}}">
                <TextBlock
                    Text="{Binding ImageId}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="8,0,8,0"
                    Padding="4,2"
                    FontFamily="{Binding FontFamily, Converter={StaticResource DrawingFontFamilyToMediaFontFamily}, Mode=OneWay}"
                    FontSize="{Binding FontSize}"
                    Foreground="{Binding FontColor, Converter={StaticResource Col2Brush}}"
                    Background="Transparent"/>
            </Border>
            <Border
                x:Name="namesRegionBorder"
                Canvas.Left="0"
                Visibility="{Binding NameManager.IsEnabled, Mode=OneWay ,Converter={StaticResource Bool2Vis}}"
                Canvas.Top="{Binding ActualHeight, ElementName=pageimg, Mode=OneWay}"
                Width="{Binding ActualWidth, ElementName=pageimg, Mode=OneWay}"
                Height="{Binding PictureVM.NamesRegionHeight}"
                BorderThickness="1,0,1,1"
                BorderBrush="Black"
                Background="{Binding NameManager.BackgroundColor, Converter={StaticResource Col2Brush}}">
                <Border.RenderTransform>
                    <TranslateTransform Y="{Binding ImageIdManager.LineHeight}"/>
                </Border.RenderTransform>
            </Border>

            <ItemsControl
                Canvas.Left="0"
                Canvas.Top="0"
                Width="{Binding ActualWidth, ElementName=pageimg, Mode=OneWay}"
                Height="{Binding ActualHeight, ElementName=PageCanvas, Mode=OneWay}"
                Visibility="{Binding NameManager.IsEnabled, Mode=OneWay ,Converter={StaticResource Bool2Vis}}"
                ItemsSource="{Binding NameManager.RowDividers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas IsHitTestVisible="False"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}"
                                Height="{Binding Height}"
                                BorderBrush="#AA787878"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Padding="8,0,8,0">
                            <TextBlock
                                Text="{Binding Text}"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                TextAlignment="Left"
                                FontFamily="{Binding Source={x:Static vm:TextLabel.Style}, Path=FontFamily, Converter={StaticResource DrawingFontFamilyToMediaFontFamily}}"
                                FontSize="{Binding Source={x:Static vm:TextLabel.Style}, Path=FontSize}"
                                Foreground="{Binding DataContext.NameManager.FontColor, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}}, Converter={StaticResource Col2Brush}}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Canvas x:Name="rowDefinitionOverlay"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="{Binding Page.ImageWidth, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}"
                    Height="{Binding Page.ImageHeight, RelativeSource={RelativeSource AncestorType={x:Type view:PictureDisplay}, Mode=FindAncestor}}"
                    Background="Transparent"
                    Visibility="Collapsed"
                    IsHitTestVisible="True"/>

            <Canvas x:Name="rowEditStrip"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="54"
                    Height="{Binding ActualHeight, ElementName=pageimg, Mode=OneWay}"
                    Background="Transparent"
                    Visibility="{Binding RowDefinitionManager.IsRowDefinitionMode, Converter={StaticResource Bool2Vis}}"
                    MouseMove="RowEditStrip_MouseMove"
                    MouseLeave="RowEditStrip_MouseLeave"
                    MouseLeftButtonDown="RowEditStrip_MouseLeftButtonDown"
                    IsHitTestVisible="True">
                <Line x:Name="rowInsertGhost"
                      X1="4"
                      X2="20"
                      Y1="0"
                      Y2="0"
                      Stroke="#E600BCD4"
                      StrokeThickness="2"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"/>
                <iconPacks:PackIconMaterial x:Name="rowStripHeader"
                                            Kind="PlusCircleOutline"
                                            Foreground="#AA4A4A4A"
                                            Width="14"
                                            Height="14"
                                            IsHitTestVisible="False"/>
                <Canvas x:Name="rowChipHost"
                        Canvas.Left="0"
                        Width="22"
                        Height="{Binding ActualHeight, ElementName=pageimg, Mode=OneWay}"
                        IsHitTestVisible="True"/>
            </Canvas>
        </Canvas>
    </view:ZoomBorder>
</UserControl>
