<UserControl
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Infrastructure="clr-namespace:AutoNumber.Infrastructure" x:Class="AutoNumber.Views.FaceAnchorPicker"
    mc:Ignorable="d"
    d:DesignHeight="90" d:DesignWidth="90">

    <UserControl.Resources>
        <Infrastructure:EnumBooleanConverter x:Key="EnumBooleanConverter"/>

        <Style x:Key="FaceAnchorDotStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Ellipse x:Name="Dot"
                                 Width="12" Height="12"
                                 Stroke="{DynamicResource MahApps.Brushes.Accent}"
                                 StrokeThickness="2"
                                 Fill="Transparent"
                                 ToolTip="{TemplateBinding ToolTip}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="90" Height="90"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <RadioButton Grid.Row="0" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben links"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopLeft}"/>
            <RadioButton Grid.Row="0" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben Mitte"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopCenter}"/>
            <RadioButton Grid.Row="0" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben rechts"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopRight}"/>

            <RadioButton Grid.Row="1" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte links"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MiddleLeft}"/>
            <RadioButton Grid.Row="1" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Center}"/>
            <RadioButton Grid.Row="1" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte rechts"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MiddleRight}"/>

            <RadioButton Grid.Row="2" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten links"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomLeft}"/>
            <RadioButton Grid.Row="2" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten Mitte (Standard)"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomCenter}"/>
            <RadioButton Grid.Row="2" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten rechts"
                         IsChecked="{Binding SelectedAnchor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomRight}"/>
        </Grid>
    </Border>
</UserControl>
