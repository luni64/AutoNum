<mah:MetroWindow x:Class="AutoNumber.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:Infrastructure="clr-namespace:AutoNumber.Infrastructure"
                 xmlns:view="clr-namespace:AutoNumber.Views"
                 mc:Ignorable="d"
                 Title="Einstellungen"
                 Width="760"
                 Height="640"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip">
    <mah:MetroWindow.Resources>
        <Infrastructure:ColorConverter x:Key="ColorConverter"/>
        <Infrastructure:EnumBooleanConverter x:Key="EnumBooleanConverter"/>

        <Style x:Key="FaceAnchorDotStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Ellipse x:Name="Dot"
                                 Width="18" Height="18"
                                 Stroke="{DynamicResource MahApps.Brushes.Accent}"
                                 StrokeThickness="2"
                                 Fill="Transparent"
                                 ToolTip="{TemplateBinding ToolTip}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>
    <Grid Margin="16" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TabControl 
            Grid.Row="0" Margin="0,0,0,0"
            TabStripPlacement="Left" 
            mah:HeaderedControlHelper.HeaderFontSize="16" 
            mah:HeaderedControlHelper.HeaderFontWeight="Bold" >
            <TabItem Header="Formatierung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,14" FontSize="14">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Standardwerte für neue Bilder
							</Run>
							<LineBreak/>
							<Run>
								AutoNumber bestimmt beim Laden eines Bildes automatisch eine Basis-Schriftgröße basierend auf der Auflösung und Größe des Bildes. Mit den Schiebereglern können Sie Faktoren relativ zu dieser Basis-Schriftgröße einstellen (100% = Basis-Schriftgröße). Zusätzlich können Sie hier Standard-Schrift-, Rand- und Hintergrundfarben festlegen.
							</Run>
                        </TextBlock>

                        <TextBlock Text="Nummern" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding DefaultLabelDiameterScale, Mode=TwoWay}"
							FontColor="{Binding DefaultLabelFontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding DefaultLabelBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							EdgeColor="{Binding DefaultLabelEdgeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							ShowEdgeColor="True"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Titel" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding DefaultTitleFontScale, Mode=TwoWay}"
							FontColor="{Binding DefaultTitleFontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding DefaultTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Beschreibung" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding DefaultImageInfoFontScale, Mode=TwoWay}"
							FontColor="{Binding DefaultImageInfoFontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding DefaultImageInfoBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Bild-ID" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding DefaultImageIdFontScale, Mode=TwoWay}"
							FontColor="{Binding DefaultImageIdFontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding DefaultImageIdBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Namensliste" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding DefaultNamesFontScale, Mode=TwoWay}"
							FontColor="{Binding DefaultNamesFontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding DefaultNamesBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <Button
							Content="Auf das aktuelle Bild Anwenden"
							ToolTip="Übernimmt die Standardwerte für das aktuelle Bild"
							Click="Apply_Click"
							Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
							FontSize="13"
							mah:ControlsHelper.ContentCharacterCasing="Upper"
							Padding="10"
							Margin="0,10,0,0"
							HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sichtbarkeit">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Standard-Sichtbarkeit für neue Bilder" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#666666" FontSize="12">
							Lege fest, welche Elemente bei neu geladenen Bildern standardmäßig sichtbar sein sollen. Diese Einstellungen beeinflussen nur neue Bilder und können pro Bild weiterhin individuell angepasst werden.
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding DefaultTitleEnabled}" Content="Titel anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding DefaultImageInfoEnabled}" Content="Beschreibung anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding DefaultImageIdEnabled}" Content="Bild-ID anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding DefaultNamesEnabled}" Content="Namensliste anzeigen"/>

                        <Button Content="Anwenden" Padding="8,4" Margin="0,12,0,0" Click="ApplyVisibility_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Erkennung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,14" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Automatische Erkennung
							</Run>
							<LineBreak/>
							<Run>
								Hier steuern Sie, ob AutoNumber beim Laden neuer Bilder automatisch Gesichter erkennt und daraus Reihen ableitet. Wenn die Gesichtserkennung deaktiviert ist, kann die Reihen-Erkennung nicht aktiviert werden.
							</Run>
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding FaceDetectionEnabled, Mode=TwoWay}" Content="Gesichtserkennung verwenden" Margin="0,0,0,8"/>
                        <mah:ToggleSwitch IsOn="{Binding RowDetectionEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableRowDetection}" Content="Reihenerkennung verwenden" Margin="0,0,0,14"/>

						<TextBlock Text="Position des Labels im Gesicht" Margin="0,25,0,4" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
						<TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
							Legt fest, an welcher Stelle des erkannten Gesichts das Nummern-Label platziert wird. Wirkt sich nur auf neu erkannte Gesichter aus.
						</TextBlock>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
							<Border Width="150" Height="150"
									BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
									BorderThickness="2">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition/>
										<RowDefinition/>
										<RowDefinition/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition/>
										<ColumnDefinition/>
										<ColumnDefinition/>
									</Grid.ColumnDefinitions>

									<RadioButton Grid.Row="0" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben links"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopLeft}"/>
									<RadioButton Grid.Row="0" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben Mitte"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopCenter}"/>
									<RadioButton Grid.Row="0" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Oben rechts"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=TopRight}"/>

									<RadioButton Grid.Row="1" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte links"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MiddleLeft}"/>
									<RadioButton Grid.Row="1" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Center}"/>
									<RadioButton Grid.Row="1" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mitte rechts"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=MiddleRight}"/>

									<RadioButton Grid.Row="2" Grid.Column="0" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten links"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomLeft}"/>
									<RadioButton Grid.Row="2" Grid.Column="1" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten Mitte (Standard)"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomCenter}"/>
									<RadioButton Grid.Row="2" Grid.Column="2" GroupName="FaceAnchor" Style="{StaticResource FaceAnchorDotStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Unten rechts"
												 IsChecked="{Binding FaceLabelAnchor, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=BottomRight}"/>
								</Grid>
							</Border>
						</StackPanel>

						<TextBlock TextWrapping="Wrap" Margin="0,25,0,14" FontSize="12">
						<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
					Parameter für die Gesichtserkennung
					</Run>
						</TextBlock>

						<TextBlock Text="Erkennungsschwelle" Margin="0,0,0,4" FontWeight="SemiBold"/>
						<Grid Margin="0,0,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="180"/>
								<ColumnDefinition Width="72"/>
								<ColumnDefinition Width="92"/>
							</Grid.ColumnDefinitions>
							<Slider Grid.Column="0"
									Minimum="0.1"
									Maximum="0.95"
									Value="{Binding FaceDetectionScoreThreshold, Mode=TwoWay}"
									Width="170"
									HorizontalAlignment="Left"/>
							<TextBox Grid.Column="1"
								 Text="{Binding FaceDetectionScoreThreshold, Mode=OneWay, StringFormat={}{0:0.00}}"
								 IsReadOnly="True"
								 HorizontalContentAlignment="Right"
								 Margin="8,0,8,0"
								 Padding="6,4"/>
							<Button Grid.Column="2"
									Content="Standard"
									Click="ResetFaceDetectionScoreThreshold_Click"
									Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
									FontSize="12"
									mah:ControlsHelper.ContentCharacterCasing="Upper"
									Padding="8,4"
									HorizontalAlignment="Left"/>
						</Grid>
						<TextBlock TextWrapping="Wrap" Margin="0,4,0,10">
						   Legt fest, wie sicher die Erkennung sein muss, damit ein Bereich als Gesicht gilt. Niedrigere Werte erkennen mehr Gesichter, auch auf älteren oder unscharfen Fotos, können aber vereinzelt Fehl-Erkennungen verursachen.
						</TextBlock>

						<Button Content="Neu Erkennen"
								Click="RedetectFaces_Click"
								Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
								FontSize="13"
								mah:ControlsHelper.ContentCharacterCasing="Upper"
								Padding="5"
								Margin="0,6,0,0"
								HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Export- und Speichereinstellungen
							</Run>
							<LineBreak/>
							<Run>
								Beim Speichern eines Bildes kann AutoNumber automatisch ein Suffix an den Dateinamen des exportieren Bildes anhängen.
							</Run>
							<LineBreak/><LineBreak/>
							<Run FontWeight="SemiBold">
								Suffix für gespeicherte Dateien
							</Run>
                        </TextBlock>

                        <TextBox Text="{Binding SaveFileSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								 Padding="6,4" Margin="0,0,0,14"
								 ToolTip="z.B. '_num', 'revision_01' oder leer für kein Suffix"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,14" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Zusätzliche Exporte
							</Run>
							<LineBreak/>
							<Run>
								Optional können zusätzliche Dateien mit Metadaten (CSV und JSON) erzeugt werden. In den erzeugten Dateien werden allgemeine Daten wie Titel, Beschreibung und ID, sowie die Namensliste gespeichert. Diese Dateien können für die Weiterverarbeitung in anderen Programmen (Excel, Datenbanken,...) genutzt werden.
							</Run>
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding ExportCsvMetadata}" Content="CSV (Excel) Daten" Margin="0,0,0,8"/>
                        <mah:ToggleSwitch IsOn="{Binding ExportJsonMetadata}" Content="JSON Daten" Margin="0,0,0,0"/>

                        <Button Content="Jetzt Exportieren"
								Click="ExportNow_Click"
								IsEnabled="{Binding CanExportNow}"
								Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
								FontSize="13"
								mah:ControlsHelper.ContentCharacterCasing="Upper"
								Padding="10"
								Width="auto"
								Margin="0,10,0,0"
								HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
				Content="Schliessen"
				Click="Close_Click"
				Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
				FontSize="13"
				mah:ControlsHelper.ContentCharacterCasing="Upper"
				Padding="10"
				Width="110"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
