<mah:MetroWindow x:Class="AutoNumber.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:Infrastructure="clr-namespace:AutoNumber.Infrastructure"
                 xmlns:view="clr-namespace:AutoNumber.Views"
                 mc:Ignorable="d"
                 Title="Einstellungen"
                 Width="760"
                 Height="640"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip">
    <mah:MetroWindow.Resources>
        <Infrastructure:ColorConverter x:Key="ColorConverter"/>
        <Infrastructure:EnumBooleanConverter x:Key="EnumBooleanConverter"/>
    </mah:MetroWindow.Resources>
    <Grid Margin="16" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TabControl 
            Grid.Row="0" Margin="0,0,0,0"
            TabStripPlacement="Left" 
            mah:HeaderedControlHelper.HeaderFontSize="16" 
            mah:HeaderedControlHelper.HeaderFontWeight="Bold" >
            <TabItem Header="Formatierung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,14" FontSize="14">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Standardwerte für neue Bilder
							</Run>
							<LineBreak/>
							<Run>
								AutoNumber bestimmt beim Laden eines Bildes automatisch eine Basis-Schriftgröße basierend auf der Auflösung und Größe des Bildes. Mit den Schiebereglern können Sie Faktoren relativ zu dieser Basis-Schriftgröße einstellen (100% = Basis-Schriftgröße). Zusätzlich können Sie hier Standard-Schrift-, Rand- und Hintergrundfarben festlegen.
							</Run>
                        </TextBlock>

                        <TextBlock Text="Nummern" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding Labels.Scale, Mode=TwoWay}"
							FontColor="{Binding Labels.FontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding Labels.BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							EdgeColor="{Binding Labels.EdgeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							ShowEdgeColor="True"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Titel" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding Title.Scale, Mode=TwoWay}"
							FontColor="{Binding Title.FontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding Title.BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Beschreibung" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding ImageInfo.Scale, Mode=TwoWay}"
							FontColor="{Binding ImageInfo.FontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding ImageInfo.BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Bild-ID" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding ImageId.Scale, Mode=TwoWay}"
							FontColor="{Binding ImageId.FontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding ImageId.BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <TextBlock Text="Namensliste" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <view:FontManager
							SelectedScale="{Binding Names.Scale, Mode=TwoWay}"
							FontColor="{Binding Names.FontColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							BackgroundColor="{Binding Names.BackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}"
							Margin="0,0,0,14"/>

                        <Button
							Content="Auf das aktuelle Bild Anwenden"
							ToolTip="Übernimmt die Standardwerte für das aktuelle Bild"
							Click="Apply_Click"
							Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
							FontSize="13"
							mah:ControlsHelper.ContentCharacterCasing="Upper"
							Padding="10"
							Margin="0,10,0,0"
							HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sichtbarkeit">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Standard-Sichtbarkeit für neue Bilder" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#666666" FontSize="12">
							Lege fest, welche Elemente bei neu geladenen Bildern standardmäßig sichtbar sein sollen. Diese Einstellungen beeinflussen nur neue Bilder und können pro Bild weiterhin individuell angepasst werden.
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding Title.Enabled}" Content="Titel anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding ImageInfo.Enabled}" Content="Beschreibung anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding ImageId.Enabled}" Content="Bild-ID anzeigen" Margin="0,0,0,10"/>
                        <mah:ToggleSwitch IsOn="{Binding Names.Enabled}" Content="Namensliste anzeigen"/>

                        <Button Content="Anwenden" Padding="8,4" Margin="0,12,0,0" Click="ApplyVisibility_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Erkennung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,14" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Automatische Erkennung
							</Run>
							<LineBreak/>
							<Run>
								Hier steuern Sie, ob AutoNumber beim Laden neuer Bilder automatisch Gesichter erkennt und daraus Reihen ableitet. Wenn die Gesichtserkennung deaktiviert ist, kann die Reihen-Erkennung nicht aktiviert werden.
							</Run>
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding FaceDetectionEnabled, Mode=TwoWay}" Content="Gesichtserkennung verwenden" Margin="0,0,0,8"/>
                        <mah:ToggleSwitch IsOn="{Binding RowDetectionEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEnableRowDetection}" Content="Reihenerkennung verwenden" Margin="0,0,0,14"/>

						<TextBlock Text="Position des Labels im Gesicht" Margin="0,25,0,4" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
						<TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
							Legt fest, an welcher Stelle des erkannten Gesichts das Nummern-Label bei der automatischen Erkennung platziert wird (Standardwert für neu geladene Bilder). Diese Position kann auch pro Bild im Formatierungsdialog der Nummern-Labels angepasst werden.
						</TextBlock>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
							<view:FaceAnchorPicker SelectedAnchor="{Binding FaceLabelAnchor, Mode=TwoWay}"/>
						</StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Margin="12,0">
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Export- und Speichereinstellungen
							</Run>
							<LineBreak/>
							<Run>
								Diese Einstellungen legen fest, wie AutoNumber beim Speichern eines Bildes vorgeht.
							</Run>
							<LineBreak/><LineBreak/>
							<Run FontWeight="SemiBold">
								Standardformat für "Speichern unter"
							</Run>
							<LineBreak/>
							<Run>
								Legt fest, welches Format im Dialog "Speichern unter" vorausgewählt ist.
							</Run>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton GroupName="DefaultSaveFormat" Content="JPG" Margin="0,0,20,0"
                                         IsChecked="{Binding DefaultSaveFormat, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Jpg}"/>
                            <RadioButton GroupName="DefaultSaveFormat" Content="PDF"
                                         IsChecked="{Binding DefaultSaveFormat, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Pdf}"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" FontWeight="SemiBold">
                            Suffix für gespeicherte Dateien
                        </TextBlock>
                        <TextBox Text="{Binding SaveFileSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								 Padding="6,4" Margin="0,0,0,14"
								 ToolTip="z.B. '_num', 'revision_01' oder leer für kein Suffix"/>

                        <mah:ToggleSwitch IsOn="{Binding UseCustomOutputFolder}" Content="Eigenen Ausgabeordner verwenden" Margin="0,0,0,8"/>

                        <Grid IsEnabled="{Binding UseCustomOutputFolder}" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Zielordner für gespeicherte JPG-/PDF-Dateien"/>
                            <Button Grid.Column="1" Content="Durchsuchen..."
                                    Click="BrowseOutputFolder_Click"
                                    Padding="10,4"/>
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,14" FontSize="12">
							<Run FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource MahApps.Brushes.Accent}">
								Zusätzliche Exporte
							</Run>
							<LineBreak/>
							<Run>
								Optional können zusätzliche Dateien mit Metadaten (CSV und JSON) erzeugt werden. In den erzeugten Dateien werden allgemeine Daten wie Titel, Beschreibung und ID, sowie die Namensliste gespeichert. Diese Dateien können für die Weiterverarbeitung in anderen Programmen (Excel, Datenbanken,...) genutzt werden.
							</Run>
                        </TextBlock>

                        <mah:ToggleSwitch IsOn="{Binding ExportCsvMetadata}" Content="CSV (Excel) Daten" Margin="0,0,0,8"/>
                        <mah:ToggleSwitch IsOn="{Binding ExportJsonMetadata}" Content="JSON Daten" Margin="0,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button
				Content="OK"
				Click="Ok_Click"
				IsDefault="True"
				Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
				FontSize="13"
				mah:ControlsHelper.ContentCharacterCasing="Upper"
				Padding="10"
				Width="110"
				Margin="0,0,8,0"/>
            <Button
				Content="Abbrechen"
				Click="Cancel_Click"
				IsCancel="True"
				Style="{StaticResource MahApps.Styles.Button.Square}"
				FontSize="13"
				mah:ControlsHelper.ContentCharacterCasing="Upper"
				Padding="10"
				Width="110"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
