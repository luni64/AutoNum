<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>autonumber_taskbar.ico</ApplicationIcon>
    <!-- Single source for the app version shown in the window title (MainVM.Title).
         The installer version in installer\setup.iss is still bumped separately at release time. -->
    <Version>2.3.0</Version>
    <!-- Pin the runtime so builds only contain win-x64 native libraries.
         Without this, Emgu.CV and QuestPDF also copy natives for win-x86/arm64,
         linux and osx into the output (~113 MB dead weight in installer/ZIP). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="autonumber_taskbar.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.10.0.5680" />
    <PackageReference Include="Emgu.CV.Wpf" Version="4.10.0.5680" />
    <PackageReference Include="MahApps.Metro" Version="3.0.0-alpha0513" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="5.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <!-- ExcludeAssets skips the package's targets file, whose only effect is
         copying QuestPDF's bundled 11 MB LatoFont folder into the output.
         AutoNum never uses Lato (the PDF report sets Helvetica as page default,
         all other text uses user-chosen system fonts). -->
    <PackageReference Include="QuestPDF" Version="2026.6.1" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Classifiers\face_detection_yunet_2023mar.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
